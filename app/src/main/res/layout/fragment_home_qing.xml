<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <!-- 顶部搜索栏区域 -->
    <LinearLayout
        android:id="@+id/top_search_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 搜索卡片 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/search_card"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="26dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_search"
                    android:tint="@color/text_hint"
                    android:contentDescription="搜索" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="向下滑动快速搜索"
                    android:textColor="@color/text_hint"
                    android:textSize="15sp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 设置按钮 -->
        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_circle_button"
            android:src="@drawable/ic_settings"
            android:contentDescription="设置"
            android:padding="12dp" />

    </LinearLayout>

    <!-- 主内容区域 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/content_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/top_search_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="120dp">

            <!-- 智能文件夹区域标题 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="智能分类"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_auto_classify"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle_button_transparent"
                    android:src="@drawable/ic_automatic"
                    android:contentDescription="自动分类"
                    android:padding="8dp" />

            </LinearLayout>

            <!-- 智能文件夹网格 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/folder_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_folder_card" />

            <!-- 常用应用标题 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="常用应用"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_all_apps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="全部应用"
                    android:textColor="@color/primary"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- 常用应用网格 - 更大尺寸，更少数量 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/app_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_app_qing" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- 悬浮操作按钮组 - 氢桌面风格悬浮按钮 -->
    <LinearLayout
        android:id="@+id/floating_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="100dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 添加按钮 -->
        <ImageButton
            android:id="@+id/btn_add_shortcut"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_floating_button"
            android:src="@drawable/ic_add"
            android:contentDescription="添加快捷方式"
            android:padding="16dp"
            android:layout_marginBottom="12dp" />

        <!-- 壁纸按钮 -->
        <ImageButton
            android:id="@+id/btn_wallpaper"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_floating_button"
            android:src="@drawable/ic_wallpaper"
            android:contentDescription="壁纸"
            android:padding="16dp" />

    </LinearLayout>

    <!-- 音乐迷你播放器 -->
    <include
        android:id="@+id/music_mini_player"
        layout="@layout/view_music_mini_player"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
