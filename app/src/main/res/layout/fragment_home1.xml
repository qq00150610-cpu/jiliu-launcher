<?xml version="1.0" encoding="utf-8"?>
<!-- 车载桌面主布局 - 竖屏版本 -->
<!-- 布局结构：顶部状态栏 → 地图弹窗 → 媒体播放 → 应用网格 → 快捷操作 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- 主内容 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <!-- 顶部状态栏区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="8dp">

            <!-- 用户头像 -->
            <ImageView
                android:id="@+id/user_avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_car_circle_button"
                android:padding="6dp"
                android:src="@drawable/ic_app"
                android:scaleType="centerInside"
                app:tint="@color/white"
                android:contentDescription="用户" />

            <!-- 时间和日期 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp"
                    android:fontFamily="sans-serif-light"
                    tools:text="14:30" />

                <TextView
                    android:id="@+id/text_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="2024年4月19日 周五" />

            </LinearLayout>

            <!-- 天气信息 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:background="@drawable/bg_car_glass_card"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/icon_weather"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_nav"
                    app:tint="@color/primary" />

                <TextView
                    android:id="@+id/text_weather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    tools:text="25°C" />

            </LinearLayout>

            <!-- 设置按钮 -->
            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_car_circle_button"
                android:src="@drawable/ic_settings"
                android:padding="8dp"
                app:tint="@color/white"
                android:contentDescription="设置" />

        </LinearLayout>

        <!-- 功能卡片区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <!-- 地图弹窗卡片 -->
            <LinearLayout
                android:id="@+id/card_map"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_car_map_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="导航"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:src="@drawable/ic_nav"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="点击打开导航"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- 媒体播放卡片 -->
            <LinearLayout
                android:id="@+id/card_media"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_car_media_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="音乐"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- 歌曲信息 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_car_app_icon"
                        android:padding="6dp"
                        android:src="@drawable/ic_music"
                        app:tint="@color/primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_music_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="暂无播放"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/text_music_artist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="点击播放音乐"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:maxLines="1" />

                    </LinearLayout>

                </LinearLayout>

                <!-- 播放控制 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btn_music_prev"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_car_control_button"
                        android:src="@drawable/ic_previous"
                        android:padding="8dp"
                        app:tint="@color/white"
                        android:contentDescription="上一首" />

                    <ImageButton
                        android:id="@+id/btn_music_play"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="16dp"
                        android:background="@drawable/bg_car_play_button"
                        android:src="@drawable/ic_play"
                        android:padding="10dp"
                        app:tint="@color/white"
                        android:contentDescription="播放/暂停" />

                    <ImageButton
                        android:id="@+id/btn_music_next"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_car_control_button"
                        android:src="@drawable/ic_next"
                        android:padding="8dp"
                        app:tint="@color/white"
                        android:contentDescription="下一首" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- 应用网格 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/app_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            tools:listitem="@layout/item_home_app" />

    </LinearLayout>

    <!-- 底部快捷操作按钮 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="100dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btn_wallpaper"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_car_glass_card"
            android:src="@drawable/ic_wallpaper"
            android:padding="12dp"
            app:tint="@color/primary"
            android:contentDescription="更换壁纸" />

        <ImageButton
            android:id="@+id/btn_refresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_car_glass_card"
            android:src="@drawable/ic_refresh"
            android:padding="12dp"
            app:tint="@color/white"
            android:contentDescription="刷新" />

        <ImageButton
            android:id="@+id/btn_toggle_mode"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_car_glass_card"
            android:src="@drawable/ic_switch"
            android:padding="12dp"
            app:tint="@color/white"
            android:contentDescription="切换模式" />

    </LinearLayout>

</FrameLayout>
