<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ========== 车载桌面主题 - 深色毛玻璃风格 ========== -->
    
    <!-- 主主题 - 透明背景，让壁纸透出 -->
    <style name="Theme.JiLiuLauncher" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        
        <!-- 透明背景，壁纸透出 -->
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        
        <!-- 状态栏透明 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        
        <!-- 浅色状态栏图标（深色壁纸时） -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- 主界面主题 -->
    <style name="Theme.JiLiuLauncher.Main" parent="Theme.JiLiuLauncher">
        <item name="android:windowFullscreen">false</item>
    </style>

    <!-- 全屏主题 -->
    <style name="Theme.JiLiuLauncher.Fullscreen" parent="Theme.JiLiuLauncher">
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- 播放器主题 -->
    <style name="Theme.JiLiuLauncher.Player" parent="Theme.JiLiuLauncher">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- ========== 控件样式 ========== -->

    <!-- 主按钮样式 -->
    <style name="Widget.JiLiu.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/primary</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <!-- 卡片样式 - 车载毛玻璃 -->
    <style name="Widget.JiLiu.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- 大卡片样式（地图/媒体弹窗） -->
    <style name="Widget.JiLiu.Card.Large" parent="Widget.JiLiu.Card">
        <item name="cardCornerRadius">24dp</item>
    </style>

    <!-- 搜索框样式 -->
    <style name="Widget.JiLiu.SearchBox" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">26dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- 悬浮按钮样式 -->
    <style name="Widget.JiLiu.FloatingButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/primary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.JiLiu.FloatingButton</item>
    </style>

    <!-- 悬浮按钮形状 -->
    <style name="ShapeAppearance.JiLiu.FloatingButton" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">50%</item>
    </style>

    <!-- ========== 文字样式 ========== -->

    <!-- 主标题 -->
    <style name="TextAppearance.JiLiu.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- 副标题 -->
    <style name="TextAppearance.JiLiu.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- 正文 -->
    <style name="TextAppearance.JiLiu.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- 标签文字 -->
    <style name="TextAppearance.JiLiu.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/text_hint</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- ========== 状态栏/时间显示 ========== -->

    <!-- 时间显示 -->
    <style name="TextAppearance.JiLiu.Time" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">48sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>

    <!-- 日期显示 -->
    <style name="TextAppearance.JiLiu.Date" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- ========== 音乐播放器样式 ========== -->

    <!-- 歌曲名 -->
    <style name="TextAppearance.JiLiu.Music.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- 歌手名 -->
    <style name="TextAppearance.JiLiu.Music.Artist" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
